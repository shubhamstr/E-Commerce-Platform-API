# Environment
NODE_ENV=production
PORT=5010

# Security
JWT_SECRET=ecom_prod_secret_key

# Database Configuration (MySQL / Postgres)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_NAME=ecom_prod
DB_USER=root
DB_PASSWORD=your_db_password

# Migrations on Docker Startup (true/false)
RUN_MIGRATIONS=true

# SMTP Mail Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password_or_app_token
SMTP_FROM="E-Commerce Support <support@example.com>"

# App URLs
WEBSITE_URL=http://your-server-ip:5010
ADMIN_URL=http://your-server-ip:5010